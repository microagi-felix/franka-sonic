+def _refresh_first_observation(sim, scene, capture_cameras, frames: int = 2) -> None:
+    """Re-render and re-read the capture cameras so an episode's first image is its own.
+
+    `ManagerBasedEnv.reset` renders `cfg.num_rerenders_on_reset` times after writing the new
+    scene state, and that default is 0 — Isaac Lab's own words: "no render step will be
+    performed after reset. Data collected from sensors after performing reset will be stale and
+    will not reflect the latest states in simulation caused by the reset". `scene.reset()` marks
+    the sensors outdated, so the first `capture()` does re-read the annotators, but the
+    annotators still hold the frame rendered for the *previous* episode's last step. The policy
+    then plans its first 40-step chunk from the previous episode's image paired with post-reset
+    proprioception, which is what the whipped first chunk in P11's failing episodes looks like.
+
+    Rendering is not enough on its own: the sensors are refreshed with `force_recompute` so the
+    annotator read happens here, after the render, rather than lazily at some later access.
+    `dt=0.0` keeps the sensors' own clock where the episode left it.
+    """
+    _warm_camera_annotators(sim, frames)
+    for name in capture_cameras:
+        sensor = scene[name]
+        if hasattr(sensor, "update"):
+            sensor.update(0.0, force_recompute=True)
+
