{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(~/Isaac-GR00T/.venv/bin/python *)",
      "Bash(/isaac-sim/python.sh *)",
      "Bash(/isaac-sim/kit/python/bin/python3 *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(find *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(id *)",
      "Bash(tmux *)",
      "Bash(bash env/bootstrap.sh*)",
      "Bash(bash harness/*)"
    ],
    "deny": [
      "Bash(rm -rf /data*)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(kubectl delete *)",
      "Bash(docker *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash harness/guard.sh"
          }
        ]
      }
    ]
  }
}
